<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\OpenMacro.Engine\OpenMacro.Engine.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Hardcodet.NotifyIcon.Wpf" Version="2.0.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- The two tray icons, off and on. Resource rather than EmbeddedResource:
         Application.GetResourceStream takes the path as written here. -->
    <Resource Include="Assets\tray-off.ico" />
    <Resource Include="Assets\tray-on.ico" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>openmacro</AssemblyName>
    <RootNamespace>OpenMacro.App</RootNamespace>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <Version>0.3.0</Version>
  </PropertyGroup>

</Project>
