<Window x:Class="OpenMacro.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="openmacro" Height="560" Width="920" MinHeight="400" MinWidth="700"
        Background="{DynamicResource Base}" Foreground="{DynamicResource Text}"
        FontFamily="{StaticResource UiFont}" FontSize="13"
        TextOptions.TextFormattingMode="Display"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Grid>
        <!-- Everything but the capture overlay lives in the shell, so key
             capture can blur it as one piece. -->
        <DockPanel x:Name="Shell">
            <!-- Bottom bar: status + master enable -->
            <Border DockPanel.Dock="Bottom" Background="{DynamicResource Surface0}"
                    BorderBrush="{DynamicResource Hairline}" BorderThickness="0,1,0,0"
                    Padding="12,7">
                <!-- MinHeight is the height the bar had when Enable was a
                     full-size button: the switch is shorter, and the bar
                     shouldn't shrink under it. -->
                <DockPanel MinHeight="29">
                    <ToggleButton x:Name="ArmToggle" DockPanel.Dock="Right"
                                  Style="{StaticResource Switch}" VerticalAlignment="Center"
                                  AutomationProperties.Name="Enable macros"
                                  ToolTip="While on, enabled macros fire on their keybinds"
                                  Checked="ArmToggle_Checked" Unchecked="ArmToggle_Unchecked"/>
                    <!-- Global hotkey that flips Enable. RegisterHotKey-based
                         (see code-behind), so it works from the tray without
                         the global hook existing while disarmed. The chip is
                         stamped by UpdateHotkeyButton. -->
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                                Margin="0,0,10,0" VerticalAlignment="Center">
                        <TextBlock Text="Enable hotkey" FontSize="12"
                                   Foreground="{DynamicResource Subtext}"
                                   VerticalAlignment="Center"/>
                        <Button x:Name="HotkeyButton" Margin="6,0,0,0"
                                Style="{StaticResource GhostButton}"
                                ToolTip="Global hotkey that toggles Enable. Works while the app is in the tray · click, then press a key · Esc cancels · right-click to clear"
                                Click="HotkeyButton_Click">
                            <Button.ContextMenu>
                                <!-- The hotkey's only way out, now that Esc
                                     cancels the capture instead of clearing. -->
                                <ContextMenu>
                                    <MenuItem x:Name="ClearHotkeyItem" Header="Clear hotkey"
                                              Click="ClearHotkey_Click"/>
                                </ContextMenu>
                            </Button.ContextMenu>
                            <ContentControl x:Name="HotkeyChip" Style="{StaticResource KeyChip}"/>
                        </Button>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse x:Name="StatusDot" Width="7" Height="7" Margin="2,1,8,0"
                                 VerticalAlignment="Center" Fill="{DynamicResource Overlay0}"/>
                        <!-- Never blank: the base line names the state and
                             messages sit over it (see Status in code-behind). -->
                        <TextBlock x:Name="StatusText"
                                   Foreground="{DynamicResource Subtext}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- The LED: lit in the accent color while macros are live, red while
                 recording, off when idle. Always present so toggling never shifts
                 the layout. -->
            <Rectangle x:Name="LiveRule" DockPanel.Dock="Bottom" Height="2" Fill="Transparent"/>

            <!-- Visual keyboard. Hidden for now (assignment happens via capture);
                 the control and its code stay for a later revisit. -->
            <Border DockPanel.Dock="Bottom" Background="{DynamicResource Surface0}" Visibility="Collapsed"
                    BorderBrush="{DynamicResource Hairline}" BorderThickness="0,1,0,0">
                <Expander Header="Keyboard" IsExpanded="True" Padding="4,4,4,8">
                    <StackPanel x:Name="KeyboardHost" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                </Expander>
            </Border>

            <!-- Left: macros (drag reorders live — wired in code by ListReorder;
                 right-click for run/rename/trigger/etc., Delete key deletes,
                 double-click toggles enabled) -->
            <Border DockPanel.Dock="Left" Width="300" Background="{DynamicResource Surface0}"
                    BorderBrush="{DynamicResource Hairline}" BorderThickness="0,0,1,0">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="14,10,10,6">
                        <Button DockPanel.Dock="Right" Content="+" Padding="8,0" FontSize="15"
                                ToolTip="New macro" Click="AddMacro_Click"/>
                        <!-- The count reads "9 of 13" while an app filter is on. -->
                        <TextBlock Style="{StaticResource Eyebrow}" VerticalAlignment="Center"
                            ><Run Text="Macros"/><Run x:Name="FilterCount" FontWeight="Normal"/></TextBlock>
                    </DockPanel>
                    <!-- App filter: "All", then one chip per app a macro is
                         filtered to (built in code). Collapsed while no macro
                         has an app filter. 22 px chips + 6 px under = 28 px. -->
                    <StackPanel x:Name="AppFilterRow" DockPanel.Dock="Top" Orientation="Horizontal"
                                Margin="14,0,10,6" Visibility="Collapsed"/>
                    <ListBox x:Name="BindingsList"
                             SelectionChanged="BindingsList_SelectionChanged"
                             PreviewMouseLeftButtonDown="BindingsList_MouseDown"
                             PreviewMouseRightButtonDown="BindingsList_RightClick"
                             MouseDoubleClick="BindingsList_MouseDoubleClick"
                             KeyDown="BindingsList_KeyDown"/>
                </DockPanel>
            </Border>

            <!-- Right: selected macro detail -->
            <Grid>
                <!-- Nothing made yet: the detail area says what a macro is
                     for and offers the one move that leads anywhere. -->
                <StackPanel x:Name="EmptyNoMacros" Visibility="Collapsed"
                            HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="No macros yet" FontSize="15"
                               Foreground="{DynamicResource Text}"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="Create one, then record your keystrokes or add steps by hand."
                               FontSize="12.5" Margin="0,4,0,0"
                               Foreground="{DynamicResource Overlay0}"
                               HorizontalAlignment="Center"/>
                    <Button x:Name="EmptyNewMacroButton" Content="New macro"
                            Margin="0,10,0,0" Padding="8,3"
                            HorizontalAlignment="Center" Click="AddMacro_Click"/>
                </StackPanel>

                <!-- Macros exist and none is picked: one line, no advice.
                     The list beside it is the advice. -->
                <TextBlock x:Name="EmptyNoSelection" Visibility="Collapsed"
                           Foreground="{DynamicResource Overlay0}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Text="Select a macro"/>

                <Grid x:Name="DetailPanel" Margin="18,14,18,14" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- name (click to rename) + everything else this macro can
                         do, behind the overflow dots -->
                    <DockPanel Grid.Row="0">
                        <Button x:Name="MoreButton" DockPanel.Dock="Right"
                                Style="{StaticResource OverflowButton}"
                                VerticalAlignment="Center"
                                AutomationProperties.Name="More actions"
                                ToolTip="More actions"
                                Click="MoreButton_Click">
                            <!-- Three middle dots tracked 2 px apart. WPF has no
                                 letter spacing, so the tracking is a margin and
                                 each dot is its own block. -->
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="·"/>
                                <TextBlock Text="·" Margin="2,0,0,0"/>
                                <TextBlock Text="·" Margin="2,0,0,0"/>
                            </StackPanel>
                        </Button>
                        <!-- Generous transparent padding = a forgiving hover/click
                             target around the title. The underline is a separate
                             rectangle so it can fade in (TextDecorations can't). -->
                        <Border x:Name="NameHover" Background="Transparent" Padding="8,4"
                                Margin="-8,-4,0,-4" HorizontalAlignment="Left"
                                VerticalAlignment="Center" Cursor="IBeam"
                                ToolTip="Click to rename"
                                MouseLeftButtonDown="NameText_Click">
                            <Grid>
                                <TextBlock x:Name="NameText" FontSize="19" FontWeight="SemiBold"/>
                                <Rectangle Height="1.5" VerticalAlignment="Bottom" Margin="1,0,1,-2"
                                           Fill="{DynamicResource Subtext}">
                                    <Rectangle.Style>
                                        <Style TargetType="Rectangle">
                                            <Setter Property="Opacity" Value="0"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsMouseOver, ElementName=NameHover}"
                                                             Value="True">
                                                    <DataTrigger.EnterActions>
                                                        <BeginStoryboard>
                                                            <Storyboard>
                                                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                                 To="1" Duration="0:0:0.15"/>
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </DataTrigger.EnterActions>
                                                    <DataTrigger.ExitActions>
                                                        <BeginStoryboard>
                                                            <Storyboard>
                                                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                                 To="0" Duration="0:0:0.20"/>
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </DataTrigger.ExitActions>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Rectangle.Style>
                                </Rectangle>
                                <TextBox x:Name="NameEditBox" Visibility="Collapsed"
                                         Style="{StaticResource GhostTextBox}"
                                         FontSize="19" FontWeight="SemiBold" MinWidth="60"
                                         HorizontalAlignment="Left"
                                         LostFocus="NameEdit_LostFocus" KeyDown="NameEdit_KeyDown"/>
                            </Grid>
                        </Border>
                    </DockPanel>

                    <!-- What the macro answers to, on one line under the title:
                         keybind, mode, and the app it is limited to. 6 px
                         between a label and its control, 8 px between groups,
                         carried by the margins so every control keeps the
                         position it had when this was a stack.

                         A Grid, because a stack cannot give way: everything up
                         to the App label is Auto and sized by its content, and
                         the App box takes the rest of the line. A long key name
                         or the × times box now shortens the box instead of
                         pushing it off the panel. -->
                    <Grid Grid.Row="1" Margin="0,10,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <!-- The Repeat box's column. Collapsed in every mode
                                 but "× times", and a collapsed control costs an
                                 Auto column nothing, margin included. -->
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <!-- The App box takes what the line has left, but
                                 no more than 220 px and no less than 120: the
                                 bounds are the column's and not the box's,
                                 because a stretched control that its own
                                 MaxWidth cuts short is centred in the space it
                                 was given, and the box would drift 37 px off
                                 its label in the default window. Both figures
                                 carry the box's 6 px margin, which lives
                                 inside the column. -->
                            <ColumnDefinition Width="*" MinWidth="126" MaxWidth="226"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Keybind"
                                   Foreground="{DynamicResource Subtext}"
                                   VerticalAlignment="Center"/>
                        <!-- Chromeless: the chip is the whole button, and it is
                             the header's size on all three of its faces, so an
                             unset or refused keybind never resizes the row. -->
                        <Button Grid.Column="1" x:Name="TriggerButton" Margin="6,0,0,0"
                                Style="{StaticResource GhostButton}"
                                VerticalAlignment="Center"
                                ToolTip="Click, then press a key · Esc cancels"
                                Click="TriggerButton_Click">
                            <ContentControl x:Name="TriggerChip"
                                            Style="{StaticResource KeyChipBig}"/>
                        </Button>
                        <TextBlock Grid.Column="2" Text="Mode"
                                   Foreground="{DynamicResource Subtext}"
                                   Margin="8,0,0,0" VerticalAlignment="Center"/>
                        <ComboBox Grid.Column="3" x:Name="ModeBox" Width="110" Margin="6,0,0,0"
                                  VerticalContentAlignment="Center" SelectionChanged="ModeBox_SelectionChanged">
                            <ComboBoxItem Content="Once"/>
                            <ComboBoxItem Content="While held"/>
                            <ComboBoxItem Content="Toggle"/>
                            <ComboBoxItem Content="× times"/>
                        </ComboBox>
                        <!-- Only visible in "× times" mode. Commits on
                             Enter/focus-loss, not per keystroke, so a
                             half-typed "10" never saves as 1. -->
                        <TextBox Grid.Column="4" x:Name="RepeatBox" Width="44" Margin="6,0,0,0"
                                 Visibility="Collapsed" TextAlignment="Center"
                                 VerticalContentAlignment="Center"
                                 ToolTip="How many times one press plays the macro"
                                 LostFocus="RepeatBox_LostFocus"
                                 KeyDown="RepeatBox_KeyDown"/>
                        <TextBlock Grid.Column="5" Text="App"
                                   Foreground="{DynamicResource Subtext}"
                                   Margin="8,0,0,0" VerticalAlignment="Center"/>
                        <!-- Items are data, not controls: a ComboBox shows the
                             selected item in the closed box as well as in the
                             list, and one visual cannot be in both places. The
                             list itself is built when the drop-down opens (see
                             AppBox_DropDownOpened).

                             220 px is the box's most, not its width (see the
                             column): it fills what the line has left, so the
                             controls before it never lose their room. -->
                        <ComboBox Grid.Column="6" x:Name="AppBox" Margin="6,0,0,0"
                                  HorizontalAlignment="Stretch"
                                  VerticalContentAlignment="Center"
                                  TextSearch.TextPath="Label"
                                  ToolTip="Limit this macro to one app · elsewhere the keybind types normally"
                                  DropDownOpened="AppBox_DropDownOpened"
                                  SelectionChanged="AppBox_SelectionChanged">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <!-- A DockPanel, not a stack: the icon and
                                         the qualifier take their width first, so
                                         the name measures against what is left
                                         and ellipsizes into it instead of
                                         clipping. It shrink-wraps, so in the
                                         drop-down, where the rows are as wide as
                                         the widest, the qualifier still follows
                                         the name instead of the row's edge. -->
                                    <DockPanel HorizontalAlignment="Left">
                                        <Image DockPanel.Dock="Left"
                                               Width="14" Height="14" Margin="0,0,6,0"
                                               VerticalAlignment="Center"
                                               Source="{Binding Icon}">
                                            <Image.Style>
                                                <Style TargetType="Image">
                                                    <Style.Triggers>
                                                        <!-- No icon resolved: the name
                                                             starts at the left edge
                                                             instead of hanging off an
                                                             empty slot. -->
                                                        <DataTrigger Binding="{Binding Icon}" Value="{x:Null}">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Image.Style>
                                        </Image>
                                        <!-- Docked, so "(not running)" is not
                                             what a long name pushes out of the
                                             closed box: it is the reason the row
                                             is in the list at all. In Overlay0,
                                             because it is the app's state and
                                             not part of its name. -->
                                        <TextBlock DockPanel.Dock="Right"
                                                   Text="{Binding Suffix}"
                                                   Foreground="{DynamicResource Overlay0}"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </DockPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                            <ComboBox.ItemContainerStyle>
                                <Style TargetType="ComboBoxItem" BasedOn="{StaticResource {x:Type ComboBoxItem}}">
                                    <Setter Property="AutomationProperties.Name" Value="{Binding Label}"/>
                                    <!-- Both halves, for the row whose name the
                                         list is too narrow to spell out. -->
                                    <Setter Property="ToolTip" Value="{Binding Label}"/>
                                </Style>
                            </ComboBox.ItemContainerStyle>
                        </ComboBox>
                    </Grid>

                    <!-- timeline header + step tools (new steps insert after the
                         selected step, or at the end when nothing is selected) -->
                    <DockPanel Grid.Row="2" Margin="0,0,0,8">
                        <TextBlock Text="Timeline" Style="{StaticResource Eyebrow}"
                                   VerticalAlignment="Center"/>
                        <!-- Step count and how long the waits add up to, stamped
                             by UpdateTimelineSummary; hidden with no steps. -->
                        <TextBlock x:Name="TimelineSummary" Margin="8,0,0,0" FontSize="11.5"
                                   Foreground="{DynamicResource Overlay0}"
                                   VerticalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button x:Name="AddStepButton" Padding="8,3" Click="AddStep_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Add"/>
                                    <Path Data="M 0,0 L 3.5,4 L 7,0" Margin="6,1,0,0"
                                          VerticalAlignment="Center"
                                          Stroke="{DynamicResource Subtext}" StrokeThickness="1.4"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="AppendRecordButton" Content="Record" Margin="6,0,0,0"
                                    Padding="8,3" ToolTip="Record input into this macro"
                                    Click="AppendRecord_Click"/>
                        </StackPanel>
                    </DockPanel>

                    <!-- steps: double-click edits the value in place, drag reorders
                         live (wired in code by ListReorder), shift-click selects a
                         range, Delete deletes the selection, right-click a row for
                         edits or empty space for inserts -->
                    <Border Grid.Row="3" Background="{DynamicResource Surface0}"
                            BorderBrush="{DynamicResource Hairline}" BorderThickness="1"
                            CornerRadius="4" Padding="2,4">
                        <Grid>
                            <ListBox x:Name="EventsList" SelectionMode="Extended"
                                     MouseDoubleClick="EventsList_MouseDoubleClick"
                                     PreviewMouseRightButtonDown="EventsList_RightClick"
                                     KeyDown="EventsList_KeyDown"/>
                            <!-- Over the list rather than in it, and hit by
                                 nothing but its two buttons: a text block
                                 without a background takes no clicks, so
                                 right-clicking the empty timeline still opens
                                 the insert menu underneath. -->
                            <StackPanel x:Name="EmptyNoSteps" Visibility="Collapsed"
                                        HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="No steps yet" FontSize="14"
                                           Foreground="{DynamicResource Text}"
                                           HorizontalAlignment="Center"/>
                                <TextBlock Text="Record your keystrokes, or add steps one at a time."
                                           FontSize="12" Margin="0,4,0,0"
                                           Foreground="{DynamicResource Overlay0}"
                                           HorizontalAlignment="Center"/>
                                <!-- The same two actions the row of tools
                                     above carries, at the same size. -->
                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0"
                                            HorizontalAlignment="Center">
                                    <Button x:Name="EmptyRecordButton" Content="Record"
                                            Padding="8,3"
                                            ToolTip="Record input into this macro"
                                            Click="AppendRecord_Click"/>
                                    <!-- The same chevron the row of tools'
                                         Add wears, drawn the same way. -->
                                    <Button x:Name="EmptyAddStepButton"
                                            Margin="6,0,0,0" Padding="8,3"
                                            Click="AddStep_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="Add step"/>
                                            <Path Data="M 0,0 L 3.5,4 L 7,0" Margin="6,1,0,0"
                                                  VerticalAlignment="Center"
                                                  Stroke="{DynamicResource Subtext}" StrokeThickness="1.4"
                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </DockPanel>

        <!-- Key-capture overlay: the shell blurs and an empty keycap waits in
             the center, its border breathing in the accent until the captured
             key stamps it. Shown/hidden in code (ShowCaptureOverlay); clicking
             anywhere cancels the capture. -->
        <Grid x:Name="CaptureOverlay" Visibility="Collapsed" Opacity="0"
              MouseLeftButtonDown="CaptureOverlay_Click">
            <Grid.Background>
                <SolidColorBrush Color="{DynamicResource BaseColor}" Opacity="0.72"/>
            </Grid.Background>
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border MinWidth="64" Height="56" Padding="16,0"
                        HorizontalAlignment="Center" CornerRadius="7" BorderThickness="1.5"
                        Background="{DynamicResource Surface1}">
                    <Border.BorderBrush>
                        <SolidColorBrush x:Name="CaptureKeycapStroke"
                                         Color="{DynamicResource Surface3Color}"/>
                    </Border.BorderBrush>
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="22" ShadowDepth="3" Opacity="0.45"/>
                    </Border.Effect>
                    <TextBlock x:Name="CaptureKeyName" FontSize="20" FontWeight="SemiBold"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock x:Name="CapturePrompt" Margin="0,20,0,0" FontSize="14.5"
                           HorizontalAlignment="Center"/>
                <TextBlock x:Name="CaptureHint" Margin="0,7,0,0" FontSize="12"
                           Foreground="{DynamicResource Overlay0}"
                           HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
