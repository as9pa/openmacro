<Window x:Class="OpenMacro.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="openmacro" Height="700" Width="920" MinHeight="520" MinWidth="760"
        Background="#FBFBFB" FontSize="13">
    <DockPanel>
        <!-- Top bar: arm / record / status -->
        <Border DockPanel.Dock="Top" Background="#FFFFFF"
                BorderBrush="#DDDDDD" BorderThickness="0,0,0,1" Padding="12,8">
            <DockPanel>
                <StackPanel Orientation="Horizontal">
                    <ToggleButton x:Name="ArmToggle" Content="Arm macros" Padding="12,4"
                                  Checked="ArmToggle_Checked" Unchecked="ArmToggle_Unchecked"/>
                    <Button x:Name="RecordButton" Content="Record" Padding="12,4" Margin="8,0,0,0"
                            Click="Record_Click"/>
                </StackPanel>
                <TextBlock x:Name="StatusText" Text="idle" Foreground="#666666"
                           HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>

        <!-- Bottom: visual keyboard (click a bound key to select it; click a
             free key to make it the selected binding's trigger) -->
        <Border DockPanel.Dock="Bottom" Background="#FFFFFF"
                BorderBrush="#DDDDDD" BorderThickness="0,1,0,0">
            <Expander Header="Keyboard" IsExpanded="True" Padding="4,4,4,8">
                <StackPanel x:Name="KeyboardHost" HorizontalAlignment="Center" Margin="0,4,0,0"/>
            </Expander>
        </Border>

        <!-- Left: bindings -->
        <Border DockPanel.Dock="Left" Width="300" Background="#FFFFFF"
                BorderBrush="#DDDDDD" BorderThickness="0,0,1,0">
            <DockPanel>
                <UniformGrid DockPanel.Dock="Bottom" Columns="2" Margin="12">
                    <Button Content="Duplicate" Padding="8,4" Margin="0,0,4,0" Click="DuplicateBinding_Click"/>
                    <Button Content="Delete" Padding="8,4" Margin="4,0,0,0" Click="DeleteBinding_Click"/>
                </UniformGrid>
                <ListBox x:Name="BindingsList" BorderThickness="0" Background="Transparent"
                         SelectionChanged="BindingsList_SelectionChanged"/>
            </DockPanel>
        </Border>

        <!-- Right: selected binding detail -->
        <Grid>
            <TextBlock x:Name="EmptyState" Foreground="#888888" TextAlignment="Center"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Text="Select a binding, or press Record to create one."/>

            <Grid x:Name="DetailPanel" Margin="16" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- name / trigger / mode -->
                <Grid Grid.Row="0" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="NameBox" Padding="6,4" VerticalContentAlignment="Center"
                             LostFocus="NameBox_LostFocus"/>
                    <Button x:Name="TriggerButton" Grid.Column="1" Margin="8,0,0,0" Padding="12,4"
                            Click="TriggerButton_Click"/>
                    <ComboBox x:Name="ModeBox" Grid.Column="2" Width="110" Margin="8,0,0,0"
                              VerticalContentAlignment="Center" SelectionChanged="ModeBox_SelectionChanged">
                        <ComboBoxItem Content="Once"/>
                        <ComboBoxItem Content="While held"/>
                        <ComboBoxItem Content="Toggle"/>
                    </ComboBox>
                </Grid>

                <!-- timeline header + step tools (new steps insert after the
                     selected step, or at the end when nothing is selected) -->
                <DockPanel Grid.Row="1" Margin="0,0,0,6">
                    <TextBlock Text="Timeline" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <Button x:Name="AppendRecordButton" Content="Record steps" Margin="10,0,0,0"
                            Padding="8,2" Click="AppendRecord_Click"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="+ key" Padding="8,2" Click="AddKey_Click"/>
                        <Button Content="+ delay" Margin="6,0,0,0" Padding="8,2" Click="AddDelay_Click"/>
                        <TextBox x:Name="AddTextBox" Width="120" Margin="8,0,0,0" Padding="4,2"
                                 VerticalContentAlignment="Center"/>
                        <Button Content="+ text" Margin="4,0,0,0" Padding="8,2" Click="AddText_Click"/>
                    </StackPanel>
                </DockPanel>

                <ListBox x:Name="EventsList" Grid.Row="2" FontFamily="Consolas"
                         SelectionChanged="EventsList_SelectionChanged"/>

                <!-- selected event editor -->
                <DockPanel Grid.Row="3" Margin="0,8,0,0">
                    <StackPanel x:Name="DelayEditor" Orientation="Horizontal" Visibility="Collapsed">
                        <TextBlock Text="Delay (ms):" VerticalAlignment="Center"/>
                        <TextBox x:Name="DelayBox" Width="70" Margin="6,0" Padding="4,2"
                                 VerticalContentAlignment="Center"/>
                        <Button Content="Apply" Padding="8,2" Click="ApplyDelay_Click"/>
                    </StackPanel>
                    <StackPanel x:Name="TextEditor" Orientation="Horizontal" Visibility="Collapsed">
                        <TextBlock Text="Text:" VerticalAlignment="Center"/>
                        <TextBox x:Name="EditTextBox" Width="180" Margin="6,0" Padding="4,2"
                                 VerticalContentAlignment="Center"/>
                        <Button Content="Apply" Padding="8,2" Click="ApplyText_Click"/>
                    </StackPanel>
                    <StackPanel x:Name="KeyEditor" Orientation="Horizontal" Visibility="Collapsed">
                        <ComboBox x:Name="KeyDirBox" Width="90" VerticalContentAlignment="Center"
                                  SelectionChanged="KeyDirBox_SelectionChanged">
                            <ComboBoxItem Content="press"/>
                            <ComboBoxItem Content="release"/>
                        </ComboBox>
                        <Button Content="Change key…" Margin="6,0,0,0" Padding="8,2" Click="ChangeKey_Click"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Move up" Padding="8,2" Click="MoveUp_Click"/>
                        <Button Content="Move down" Margin="6,0,0,0" Padding="8,2" Click="MoveDown_Click"/>
                        <Button Content="Delete event" Margin="6,0,0,0" Padding="8,2" Click="DeleteEvent_Click"/>
                    </StackPanel>
                </DockPanel>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
