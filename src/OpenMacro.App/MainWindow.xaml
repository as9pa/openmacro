<Window x:Class="OpenMacro.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="openmacro" Height="560" Width="920" MinHeight="400" MinWidth="700"
        Background="#FBFBFB" FontSize="13">
    <DockPanel>
        <!-- Top bar: arm / record / status -->
        <Border DockPanel.Dock="Top" Background="#FFFFFF"
                BorderBrush="#DDDDDD" BorderThickness="0,0,0,1" Padding="12,8">
            <DockPanel>
                <StackPanel Orientation="Horizontal">
                    <ToggleButton x:Name="ArmToggle" Content="Arm macros" Padding="12,4"
                                  Checked="ArmToggle_Checked" Unchecked="ArmToggle_Unchecked"/>
                    <Button x:Name="RecordButton" Content="Record" Padding="12,4" Margin="8,0,0,0"
                            Click="Record_Click"/>
                </StackPanel>
                <TextBlock x:Name="StatusText" Text="idle" Foreground="#666666"
                           HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>

        <!-- Left: bindings -->
        <Border DockPanel.Dock="Left" Width="300" Background="#FFFFFF"
                BorderBrush="#DDDDDD" BorderThickness="0,0,1,0">
            <DockPanel>
                <Button x:Name="DeleteBindingButton" DockPanel.Dock="Bottom" Content="Delete binding"
                        Margin="12" Padding="8,4" Click="DeleteBinding_Click"/>
                <ListBox x:Name="BindingsList" BorderThickness="0" Background="Transparent"
                         SelectionChanged="BindingsList_SelectionChanged"/>
            </DockPanel>
        </Border>

        <!-- Right: selected binding detail -->
        <Grid>
            <TextBlock x:Name="EmptyState" Foreground="#888888" TextAlignment="Center"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Text="Select a binding, or press Record to create one."/>

            <Grid x:Name="DetailPanel" Margin="16" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- name / trigger / mode -->
                <Grid Grid.Row="0" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="NameBox" Padding="6,4" VerticalContentAlignment="Center"
                             LostFocus="NameBox_LostFocus"/>
                    <Button x:Name="TriggerButton" Grid.Column="1" Margin="8,0,0,0" Padding="12,4"
                            Click="TriggerButton_Click"/>
                    <ComboBox x:Name="ModeBox" Grid.Column="2" Width="110" Margin="8,0,0,0"
                              VerticalContentAlignment="Center" SelectionChanged="ModeBox_SelectionChanged">
                        <ComboBoxItem Content="Once"/>
                        <ComboBoxItem Content="While held"/>
                        <ComboBoxItem Content="Toggle"/>
                    </ComboBox>
                </Grid>

                <!-- timeline header + add -->
                <DockPanel Grid.Row="1" Margin="0,0,0,6">
                    <TextBlock Text="Timeline" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="+ delay" Padding="8,2" Click="AddDelay_Click"/>
                        <TextBox x:Name="AddTextBox" Width="140" Margin="8,0,0,0" Padding="4,2"
                                 VerticalContentAlignment="Center"/>
                        <Button Content="+ text" Margin="4,0,0,0" Padding="8,2" Click="AddText_Click"/>
                    </StackPanel>
                </DockPanel>

                <ListBox x:Name="EventsList" Grid.Row="2" FontFamily="Consolas"
                         SelectionChanged="EventsList_SelectionChanged"/>

                <!-- selected event editor -->
                <DockPanel Grid.Row="3" Margin="0,8,0,0">
                    <StackPanel x:Name="DelayEditor" Orientation="Horizontal" Visibility="Collapsed">
                        <TextBlock Text="Delay (ms):" VerticalAlignment="Center"/>
                        <TextBox x:Name="DelayBox" Width="70" Margin="6,0" Padding="4,2"
                                 VerticalContentAlignment="Center"/>
                        <Button Content="Apply" Padding="8,2" Click="ApplyDelay_Click"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Move up" Padding="8,2" Click="MoveUp_Click"/>
                        <Button Content="Move down" Margin="6,0,0,0" Padding="8,2" Click="MoveDown_Click"/>
                        <Button Content="Delete event" Margin="6,0,0,0" Padding="8,2" Click="DeleteEvent_Click"/>
                    </StackPanel>
                </DockPanel>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
