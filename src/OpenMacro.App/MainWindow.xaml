<Window x:Class="OpenMacro.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="openmacro" Height="560" Width="920" MinHeight="400" MinWidth="700"
        Background="#FBFBFB" FontSize="13">
    <DockPanel>
        <!-- Top bar: arm / record / status -->
        <Border DockPanel.Dock="Top" Background="#FFFFFF"
                BorderBrush="#DDDDDD" BorderThickness="0,0,0,1" Padding="12,8">
            <DockPanel>
                <StackPanel Orientation="Horizontal">
                    <ToggleButton x:Name="ArmToggle" Content="Arm macros" Padding="12,4"
                                  Checked="ArmToggle_Checked" Unchecked="ArmToggle_Unchecked"/>
                    <Button x:Name="RecordButton" Content="Record" Padding="12,4" Margin="8,0,0,0"
                            Click="Record_Click"/>
                </StackPanel>
                <TextBlock x:Name="StatusText" Text="idle" Foreground="#666666"
                           HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>

        <!-- Bottom: visual keyboard. Hidden for now (assignment happens via
             capture); the control and its code stay for a later revisit. -->
        <Border DockPanel.Dock="Bottom" Background="#FFFFFF" Visibility="Collapsed"
                BorderBrush="#DDDDDD" BorderThickness="0,1,0,0">
            <Expander Header="Keyboard" IsExpanded="True" Padding="4,4,4,8">
                <StackPanel x:Name="KeyboardHost" HorizontalAlignment="Center" Margin="0,4,0,0"/>
            </Expander>
        </Border>

        <!-- Left: bindings (right-click for rename/duplicate/delete/etc.,
             Delete key deletes) -->
        <Border DockPanel.Dock="Left" Width="300" Background="#FFFFFF"
                BorderBrush="#DDDDDD" BorderThickness="0,0,1,0">
            <ListBox x:Name="BindingsList" BorderThickness="0" Background="Transparent"
                     SelectionChanged="BindingsList_SelectionChanged"
                     PreviewMouseRightButtonDown="BindingsList_RightClick"
                     MouseDoubleClick="BindingsList_MouseDoubleClick"
                     KeyDown="BindingsList_KeyDown"/>
        </Border>

        <!-- Right: selected binding detail -->
        <Grid>
            <TextBlock x:Name="EmptyState" Foreground="#888888" TextAlignment="Center"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Text="Select a binding, or press Record to create one."/>

            <Grid x:Name="DetailPanel" Margin="16" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- name / trigger / mode -->
                <Grid Grid.Row="0" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="NameBox" Padding="6,4" VerticalContentAlignment="Center"
                             LostFocus="NameBox_LostFocus"/>
                    <Button x:Name="TriggerButton" Grid.Column="1" Margin="8,0,0,0" Padding="12,4"
                            Click="TriggerButton_Click"/>
                    <ComboBox x:Name="ModeBox" Grid.Column="2" Width="110" Margin="8,0,0,0"
                              VerticalContentAlignment="Center" SelectionChanged="ModeBox_SelectionChanged">
                        <ComboBoxItem Content="Once"/>
                        <ComboBoxItem Content="While held"/>
                        <ComboBoxItem Content="Toggle"/>
                    </ComboBox>
                </Grid>

                <!-- timeline header + step tools (new steps insert after the
                     selected step, or at the end when nothing is selected) -->
                <DockPanel Grid.Row="1" Margin="0,0,0,6">
                    <TextBlock Text="Timeline" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <Button x:Name="AppendRecordButton" Content="Record steps" Margin="10,0,0,0"
                            Padding="8,2" Click="AppendRecord_Click"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="+ key" Padding="8,2" Click="AddKey_Click"/>
                        <Button Content="+ delay" Margin="6,0,0,0" Padding="8,2" Click="AddDelay_Click"/>
                        <TextBox x:Name="AddTextBox" Width="120" Margin="8,0,0,0" Padding="4,2"
                                 VerticalContentAlignment="Center"/>
                        <Button Content="+ text" Margin="4,0,0,0" Padding="8,2" Click="AddText_Click"/>
                    </StackPanel>
                </DockPanel>

                <!-- steps: double-click edits in place, drag reorders live
                     (the row moves with you), Delete key deletes,
                     right-click for more -->
                <ListBox x:Name="EventsList" Grid.Row="2" FontFamily="Consolas"
                         MouseDoubleClick="EventsList_MouseDoubleClick"
                         PreviewMouseLeftButtonDown="EventsList_MouseDown"
                         PreviewMouseMove="EventsList_MouseMove"
                         PreviewMouseLeftButtonUp="EventsList_MouseUp"
                         PreviewMouseRightButtonDown="EventsList_RightClick"
                         KeyDown="EventsList_KeyDown"/>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
