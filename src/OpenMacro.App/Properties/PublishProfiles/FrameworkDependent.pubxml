<?xml version="1.0" encoding="utf-8"?>
<!-- The release -dotnet.zip: framework-dependent, needs the .NET 10 desktop
     runtime installed. Its contents are zipped as-is (pdb aside).
     dotnet publish src\OpenMacro.App -c Release -p:PublishProfile=FrameworkDependent -->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <PublishDir>bin\publish\framework-dependent\</PublishDir>
  </PropertyGroup>
</Project>
