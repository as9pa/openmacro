<?xml version="1.0" encoding="utf-8"?>
<!-- The release .exe: self-contained single file, no .NET install needed.
     dotnet publish src\OpenMacro.App -c Release -p:PublishProfile=SingleFile
     The in-app updater can only replace this build. -->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <PublishDir>bin\publish\single-file\</PublishDir>
  </PropertyGroup>
</Project>
