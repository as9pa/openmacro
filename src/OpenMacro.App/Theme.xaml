<!--
  openmacro dark theme: "dark case, one LED".

  Warm graphite surfaces with hairline borders; a single accent that only
  lights up for live state (enabled / selection), red while recording.
  The tokens below are Theme.Default's values, declared so the designer and
  any lookup made before startup finds one; ThemeManager.Apply replaces every
  one of them at startup, and again when the accent retints to the user's
  Windows accent color (see App.ApplyWindowsAccent).
  Default WPF control chrome is light-themed and ignores a dark window
  background, so every control used gets a minimal dark template here.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ================= tokens =================
         Role names are sensvault's: bare, and a brush unless something needs
         the color itself (a scrim tinted by opacity, an animated stroke, the
         DWM caption), which is what the matching "...Color" keys are for. -->

    <Color x:Key="BaseColor">#232120</Color>
    <Color x:Key="Surface0Color">#2A2827</Color>
    <Color x:Key="Surface1Color">#33302E</Color>
    <Color x:Key="Surface2Color">#3A3633</Color>
    <Color x:Key="Surface3Color">#4C4741</Color>
    <Color x:Key="Overlay0Color">#6C655B</Color>
    <Color x:Key="SubtextColor">#A39B8E</Color>
    <Color x:Key="TextColor">#E9E4DB</Color>
    <Color x:Key="AccentColor">#7C9CBF</Color>
    <Color x:Key="RedColor">#D0685C</Color>
    <Color x:Key="PressColor">#2E2B29</Color>
    <Color x:Key="HairlineColor">#3E3A36</Color>
    <Color x:Key="AccentWashColor">#333941</Color>

    <!-- One and two steps below Base; carried for theme compatibility, no
         consumer yet. -->
    <SolidColorBrush x:Key="Crust">#1C1B1A</SolidColorBrush>
    <SolidColorBrush x:Key="Mantle">#1F1E1D</SolidColorBrush>
    <SolidColorBrush x:Key="Base" Color="{DynamicResource BaseColor}"/>
    <SolidColorBrush x:Key="Surface0" Color="{DynamicResource Surface0Color}"/>
    <SolidColorBrush x:Key="Surface1" Color="{DynamicResource Surface1Color}"/>
    <SolidColorBrush x:Key="Surface2" Color="{DynamicResource Surface2Color}"/>
    <SolidColorBrush x:Key="Surface3" Color="{DynamicResource Surface3Color}"/>
    <SolidColorBrush x:Key="Overlay0" Color="{DynamicResource Overlay0Color}"/>
    <SolidColorBrush x:Key="Subtext" Color="{DynamicResource SubtextColor}"/>
    <SolidColorBrush x:Key="Text" Color="{DynamicResource TextColor}"/>
    <SolidColorBrush x:Key="TextStrong">#F3EFE8</SolidColorBrush>
    <!-- Same ink as Text today; separate so a Classic-style theme can put
         darker text on lighter button chrome. -->
    <SolidColorBrush x:Key="ButtonText">#E9E4DB</SolidColorBrush>
    <SolidColorBrush x:Key="Accent" Color="{DynamicResource AccentColor}"/>
    <SolidColorBrush x:Key="Red" Color="{DynamicResource RedColor}"/>
    <!-- Subtext at 35% alpha: text selection stays a quiet warm gray, not the
         accent, so selecting text doesn't light the UI up. -->
    <SolidColorBrush x:Key="Selection">#59A39B8E</SolidColorBrush>

    <!-- openmacro's own roles (see Theme.cs). -->
    <SolidColorBrush x:Key="Press" Color="{DynamicResource PressColor}"/>
    <SolidColorBrush x:Key="Hairline" Color="{DynamicResource HairlineColor}"/>
    <SolidColorBrush x:Key="AccentWash" Color="{DynamicResource AccentWashColor}"/>
    <SolidColorBrush x:Key="KeyboardBound">#3B3226</SolidColorBrush>
    <SolidColorBrush x:Key="DragBacking">#F22E2B29</SolidColorBrush>

    <FontFamily x:Key="UiFont">Segoe UI Variable Text, Segoe UI</FontFamily>

    <!-- Muted section label ("Macros", "Timeline"). -->
    <Style x:Key="Eyebrow" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource Overlay0}"/>
        <Setter Property="FontSize" Value="11.5"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <Style x:Key="FocusVisual">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Rectangle Margin="-2" RadiusX="4" RadiusY="4" Opacity="0.7"
                               Stroke="{DynamicResource Accent}"
                               StrokeThickness="1" StrokeDashArray="1 2"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================= buttons ================= -->

    <Style TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource ButtonText}"/>
        <Setter Property="Background" Value="{DynamicResource Surface1}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Hairline}"/>
        <Setter Property="Padding" Value="12,5"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Chrome" CornerRadius="4" BorderThickness="1"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          RecognizesAccessKey="True"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Surface2}"/>
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Surface3}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Press}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- No face of its own: the content carries all the chrome (the hotkey
         key chip in the status bar). Hover paints a whisper of a halo 3 px
         proud of the content, on a negative margin so it costs no layout and
         the gaps either side of the button stay exact. -->
    <Style x:Key="GhostButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Chrome" Margin="-3,-2" Padding="3,2" CornerRadius="5"
                            Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Press}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Checked = live: amber text and border on an amber-washed field. -->
    <Style TargetType="ToggleButton">
        <Setter Property="Foreground" Value="{DynamicResource ButtonText}"/>
        <Setter Property="Background" Value="{DynamicResource Surface1}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Hairline}"/>
        <Setter Property="Padding" Value="12,5"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Chrome" CornerRadius="4" BorderThickness="1"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          RecognizesAccessKey="True"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Surface2}"/>
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Surface3}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource AccentWash}"/>
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                            <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================= switch ================= -->

    <!-- Master Enable: a track with a sliding knob and no label inside, so
         the bar reads as one state, not a verb that flips. -->
    <Style x:Key="Switch" TargetType="ToggleButton">
        <Setter Property="Width" Value="34"/>
        <Setter Property="Height" Value="18"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Track" CornerRadius="9"
                            Background="{DynamicResource Surface3}">
                        <!-- Knob inset 2 px all round, so its travel is
                             34 - 2 - 14 - 2 = 16. -->
                        <Ellipse x:Name="Knob" Width="14" Height="14" Margin="2,0,0,0"
                                 HorizontalAlignment="Left" VerticalAlignment="Center"
                                 Fill="{DynamicResource Subtext}">
                            <Ellipse.RenderTransform>
                                <TranslateTransform x:Name="KnobSlide"/>
                            </Ellipse.RenderTransform>
                        </Ellipse>
                    </Border>
                    <ControlTemplate.Triggers>
                        <!-- One step lighter up the ramp than the resting
                             track. Ahead of the checked trigger, so hover
                             only lifts the unchecked track; checked stays
                             flat accent. -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{DynamicResource Overlay0}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{DynamicResource Accent}"/>
                            <!-- White, not theme ink: the track underneath is
                                 the user's accent color, which can be any hue. -->
                            <Setter TargetName="Knob" Property="Fill" Value="White"/>
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="KnobSlide"
                                                         Storyboard.TargetProperty="X"
                                                         To="16" Duration="0:0:0.18">
                                            <DoubleAnimation.EasingFunction>
                                                <QuadraticEase EasingMode="EaseOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="KnobSlide"
                                                         Storyboard.TargetProperty="X"
                                                         To="0" Duration="0:0:0.18">
                                            <DoubleAnimation.EasingFunction>
                                                <QuadraticEase EasingMode="EaseOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================= key chips =================
         A key name drawn as a keycap: raised face, a heavier stroke along the
         bottom for the cap's edge. Decoration, not a control — hit testing is
         off, so a chip used as a button's content never eats the click. -->

    <Style x:Key="KeyChip" TargetType="ContentControl">
        <Setter Property="Background" Value="{DynamicResource Surface1}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Surface3}"/>
        <Setter Property="BorderThickness" Value="1,1,1,2"/>
        <Setter Property="Foreground" Value="{DynamicResource Text}"/>
        <Setter Property="Padding" Value="6,0,6,1"/>
        <Setter Property="MinWidth" Value="24"/>
        <Setter Property="Height" Value="20"/>
        <Setter Property="FontSize" Value="11.5"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="IsHitTestVisible" Value="False"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Border CornerRadius="4"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Nothing assigned yet: an empty outline, drawn by a Rectangle because
         a Border cannot dash. -->
    <Style x:Key="KeyChipUnset" TargetType="ContentControl" BasedOn="{StaticResource KeyChip}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Overlay0}"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Grid>
                        <Rectangle RadiusX="4" RadiusY="4"
                                   Fill="{TemplateBinding Background}"
                                   Stroke="{TemplateBinding BorderBrush}"
                                   StrokeThickness="1" StrokeDashArray="3 2"/>
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The same cap in the alarm ink, for a key the app has to flag. No
         consumer yet. -->
    <Style x:Key="KeyChipDanger" TargetType="ContentControl" BasedOn="{StaticResource KeyChip}">
        <Setter Property="BorderBrush" Value="{DynamicResource Red}"/>
        <Setter Property="Foreground" Value="{DynamicResource Red}"/>
    </Style>

    <!-- ================= text input ================= -->

    <Style TargetType="TextBox">
        <Setter Property="Foreground" Value="{DynamicResource Text}"/>
        <Setter Property="CaretBrush" Value="{DynamicResource Text}"/>
        <Setter Property="SelectionBrush" Value="{DynamicResource Selection}"/>
        <Setter Property="Background" Value="{DynamicResource Surface1}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Hairline}"/>
        <Setter Property="Padding" Value="6,4"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Chrome" CornerRadius="4" BorderThickness="1"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}">
                        <ScrollViewer x:Name="PART_ContentHost" Padding="{TemplateBinding Padding}"
                                      VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Surface3}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Chromeless in-place editor (the macro title): no box, no border —
         just the text with a caret, so editing looks like typing into the
         heading itself. -->
    <Style x:Key="GhostTextBox" TargetType="TextBox">
        <Setter Property="Foreground" Value="{DynamicResource Text}"/>
        <Setter Property="CaretBrush" Value="{DynamicResource Text}"/>
        <Setter Property="SelectionBrush" Value="{DynamicResource Selection}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <ScrollViewer x:Name="PART_ContentHost"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================= checkbox ================= -->

    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{DynamicResource Text}"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <Border x:Name="Box" Width="15" Height="15" CornerRadius="3"
                                BorderThickness="1" VerticalAlignment="Center"
                                BorderBrush="{DynamicResource Surface3}"
                                Background="{DynamicResource Surface1}">
                            <!-- White, not theme ink: the fill underneath is the
                                 user's accent color, which can be any hue. -->
                            <Path x:Name="Glyph" Data="M 2.5,6.5 L 5.5,9.5 L 10.5,3.5"
                                  Stroke="White" StrokeThickness="1.8"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round" Visibility="Collapsed"/>
                        </Border>
                        <ContentPresenter x:Name="Label" Margin="7,0,0,0" VerticalAlignment="Center"
                                          RecognizesAccessKey="True"/>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Content" Value="{x:Null}">
                            <Setter TargetName="Label" Property="Margin" Value="0"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Subtext}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{DynamicResource Accent}"/>
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                            <Setter TargetName="Glyph" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================= combobox ================= -->

    <ControlTemplate x:Key="ComboToggle" TargetType="ToggleButton">
        <Border x:Name="Chrome" CornerRadius="4" BorderThickness="1"
                Background="{DynamicResource Surface1}"
                BorderBrush="{DynamicResource Hairline}">
            <Path Data="M 0,0 L 3.5,4 L 7,0" Margin="0,0,10,0"
                  HorizontalAlignment="Right" VerticalAlignment="Center"
                  Stroke="{DynamicResource Subtext}" StrokeThickness="1.4"
                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Surface2}"/>
                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Surface3}"/>
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Accent}"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style TargetType="ComboBox">
        <Setter Property="Foreground" Value="{DynamicResource Text}"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton Template="{StaticResource ComboToggle}" Focusable="False"
                                      ClickMode="Press"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay,
                                                  RelativeSource={RelativeSource TemplatedParent}}"/>
                        <ContentPresenter Margin="10,0,26,0" VerticalAlignment="Center"
                                          IsHitTestVisible="False"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"/>
                        <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom"
                               AllowsTransparency="True" PopupAnimation="Fade">
                            <Border Margin="0,4,8,8" CornerRadius="4" BorderThickness="1"
                                    Background="{DynamicResource Surface0}"
                                    BorderBrush="{DynamicResource Surface3}"
                                    MinWidth="{TemplateBinding ActualWidth}"
                                    MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.4"/>
                                </Border.Effect>
                                <ScrollViewer Padding="0,4">
                                    <ItemsPresenter/>
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ComboBoxItem">
        <Setter Property="Foreground" Value="{DynamicResource Text}"/>
        <Setter Property="Padding" Value="10,5"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="Chrome" Background="Transparent" Padding="{TemplateBinding Padding}">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Surface2}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================= lists ================= -->

    <Style TargetType="ListBox">
        <Setter Property="Foreground" Value="{DynamicResource Text}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
    </Style>

    <!-- Selected row = amber rail on a raised field; hover is a whisper. -->
    <Style TargetType="ListBoxItem">
        <Setter Property="Foreground" Value="{DynamicResource Text}"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Chrome" Background="Transparent"
                            BorderThickness="2,0,0,0" BorderBrush="Transparent"
                            Padding="8,5">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Press}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Surface1}"/>
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================= menus (context + tray) ================= -->

    <Style TargetType="ContextMenu">
        <Setter Property="Background" Value="{DynamicResource Surface0}"/>
        <Setter Property="Foreground" Value="{DynamicResource Text}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <Border Background="{TemplateBinding Background}" CornerRadius="4"
                            BorderBrush="{DynamicResource Surface3}" BorderThickness="1"
                            Padding="0,4">
                        <ItemsPresenter/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- One template for leaf items AND submenu headers: MenuItem only opens
         a submenu if its template has a Popup bound to IsSubmenuOpen — without
         it, an item with children is an inert row that ignores clicks. -->
    <Style TargetType="MenuItem">
        <Setter Property="Foreground" Value="{DynamicResource Text}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Grid>
                        <Border x:Name="Chrome" Background="Transparent" Padding="10,6" Margin="4,0"
                                CornerRadius="3">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="14"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Path x:Name="Check" Data="M 0,3.5 L 2.8,6.3 L 8,0.7"
                                      VerticalAlignment="Center" Visibility="Hidden"
                                      Stroke="{DynamicResource Accent}" StrokeThickness="1.6"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                <ContentPresenter Grid.Column="1" ContentSource="Header"
                                                  VerticalAlignment="Center" RecognizesAccessKey="True"/>
                                <Path x:Name="Arrow" Grid.Column="2" Data="M 0,0 L 4,4 L 0,8"
                                      Margin="12,0,0,0" VerticalAlignment="Center" Visibility="Collapsed"
                                      Stroke="{DynamicResource Subtext}" StrokeThickness="1.4"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                            </Grid>
                        </Border>
                        <Popup IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}"
                               Placement="Right" AllowsTransparency="True" PopupAnimation="Fade"
                               Focusable="False" VerticalOffset="-5" HorizontalOffset="-2">
                            <Border Background="{DynamicResource Surface0}" CornerRadius="4"
                                    BorderBrush="{DynamicResource Surface3}" BorderThickness="1"
                                    Padding="0,4">
                                <ItemsPresenter/>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Role" Value="SubmenuHeader">
                            <Setter TargetName="Arrow" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Surface2}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Check" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================= scrollbar ================= -->

    <Style x:Key="ScrollThumb" TargetType="Thumb">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="Pill" Margin="2" CornerRadius="3" Background="#47423C"/>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Pill" Property="Background" Value="#5A544C"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ScrollPage" TargetType="RepeatButton">
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Rectangle Fill="Transparent"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ScrollBar">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Width" Value="10"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="Transparent">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Style="{StaticResource ScrollPage}"
                                              Command="ScrollBar.PageUpCommand"/>
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource ScrollThumb}"/>
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Style="{StaticResource ScrollPage}"
                                              Command="ScrollBar.PageDownCommand"/>
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto"/>
                <Setter Property="Height" Value="10"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Grid Background="Transparent">
                                <Track x:Name="PART_Track">
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton Style="{StaticResource ScrollPage}"
                                                      Command="ScrollBar.PageLeftCommand"/>
                                    </Track.DecreaseRepeatButton>
                                    <Track.Thumb>
                                        <Thumb Style="{StaticResource ScrollThumb}"/>
                                    </Track.Thumb>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton Style="{StaticResource ScrollPage}"
                                                      Command="ScrollBar.PageRightCommand"/>
                                    </Track.IncreaseRepeatButton>
                                </Track>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ================= tooltip ================= -->

    <Style TargetType="ToolTip">
        <Setter Property="Background" Value="{DynamicResource Surface0}"/>
        <Setter Property="Foreground" Value="{DynamicResource Text}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Background="{TemplateBinding Background}" CornerRadius="4"
                            BorderBrush="{DynamicResource Surface3}" BorderThickness="1"
                            Padding="8,5">
                        <ContentPresenter/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
